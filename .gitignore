# ── SENSITIVE: environment files ─────────────────────────────
# Never commit real env files — use .env.example as the template
.env
.env.*
!.env.example

# ── SENSITIVE: seed data ─────────────────────────────────────
# supabase/seed/school_template.sql is a template (placeholder values) and
# stays committed. If you ever add a real per-school or demo seed file with
# actual data in it, ignore that specific file — don't push real data to git.

# ── SENSITIVE: school build outputs ──────────────────────────
# .tar images and .env sidecars contain Supabase URLs and anon keys.
# secrets.env (JWT secret, anon/service keys, DB password) lives inside
# shule-install/ too, but is also matched explicitly below in case it's
# ever generated somewhere else.
shule-install/
*.tar
secrets.env
*.secrets.env

# ── ALWAYS COMMIT (source of truth) ──────────────────────────
# supabase/migrations/   ← schema history
# supabase/functions/    ← edge function code
# supabase/config.toml   ← function routing (no secrets)
# scripts/               ← automation
# docs/                  ← documentation
# .env.example           ← template only

# ── Test / build artefacts ───────────────────────────────────
test-results/
playwright-report/
e2e-results*.txt
unit-test-results.txt
dev-dist/
.env.*.local
.supabase-demo-ref
Thumbs.db
../.claude/worktrees/
../shule-install-guide.html
