# ── SENSITIVE: environment files ─────────────────────────────
# Never commit real env files — use .env.example as the template
.env
.env.*
!.env.example

# ── SENSITIVE: seed data ─────────────────────────────────────
# Seeds contain school-specific data (UUIDs, student names, credentials).
# Deliver via USB or apply-migrations.sh — never push to git.
supabase/seeds/

# ── SENSITIVE: school build outputs ──────────────────────────
# .tar images and .env sidecars contain Supabase URLs and anon keys.
shule-install/
*.tar

# ── ALWAYS COMMIT (source of truth) ──────────────────────────
# supabase/migrations/   ← schema history
# supabase/functions/    ← edge function code
# supabase/config.toml   ← function routing (no secrets)
# scripts/               ← automation
# docs/                  ← documentation
# .env.example           ← template only

# ── Test / build artefacts ───────────────────────────────────
test-results/
playwright-report/
e2e-results*.txt
unit-test-results.txt
dev-dist/
.env.*.local
.supabase-demo-ref
Thumbs.db
