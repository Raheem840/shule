# ═══════════════════════════════════════════════════════════════════════
# Shule — environment variables
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys/secrets. This file (.env.example)
# has no real values and IS committed, as the template for every school
# setup (see docs/NEW_SCHOOL_SETUP.md for the full install flow).
#
# Only variables prefixed VITE_ are readable by the frontend — Vite
# strips everything else from the built JS bundle. Never put a secret
# behind a VITE_ prefix; it would ship to every visitor's browser.
# ═══════════════════════════════════════════════════════════════════════


# ── 1. Supabase connection (REQUIRED — app won't start without these) ──
#
# Cloud school: Supabase Dashboard → your project → Settings → API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon public" key (safe to expose — RLS
#                             enforces access control, not this key)
#
# Local/on-prem or Hybrid school (self-hosted via docker-compose.school.yml):
#   VITE_SUPABASE_URL      = the school server's Kong gateway URL, e.g.
#                             http://<school-server-ip>:8000
#   VITE_SUPABASE_ANON_KEY = the ANON_KEY generated by
#                             `npm run usb:prepare` into that school's
#                             secrets.env (do NOT reuse another school's)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── 2. Deployment mode ──────────────────────────────────────────────────
# 'production' = real school, real data (default — use this for every
#                 actual school install).
# 'demo'       = read-only/sandboxed showcase mode for sales demos —
#                 only set this for a demo deployment, never for a real
#                 school.
VITE_SHULE_MODE=production

# Required only when VITE_SHULE_MODE=demo — the school_id row in the demo
# project's `students`/`staff` tables that the sandbox should show.
VITE_DEMO_SCHOOL_ID=


# ── 3. Push notifications (optional — app works without this section) ──
# Generate a keypair once per Supabase project with:
#   npx web-push generate-vapid-keys
#
# Public key: goes here, gets bundled into the frontend (this is the
# correct, safe half of the pair — browsers need it to subscribe).
VITE_VAPID_PUBLIC_KEY=
#
# Private key: NEVER put it here, NEVER prefix it VITE_. It signs push
# messages server-side only, inside the `send-push` edge function. Set
# it as a Supabase secret instead, once per project:
#   supabase secrets set --project-ref <ref> \
#     VAPID_PRIVATE_KEY=<private half of the pair> \
#     VAPID_PUBLIC_KEY=<same public key as above> \
#     VAPID_CONTACT_EMAIL="mailto:admin@<school-domain>"
# Until these three are set on the project, push notifications silently
# no-op (in-app/foreground notifications still work either way).


# ── 4. Local admin/seed scripts ONLY — never used by the built app ─────
# Some one-off scripts under scripts/ (e.g. seed-academic-year.ts) run
# with Node, not Vite, and need the service_role key to bypass RLS for
# initial setup. Get it from Supabase Dashboard → Settings → API →
# "service_role" (cloud), or from the school's secrets.env (local/hybrid,
# generated by `npm run usb:prepare`).
#
# DANGER: this key bypasses every RLS policy in the database. Keep it out
# of .env.local on any machine other than yours, never commit it, never
# put it behind a VITE_ prefix, never deploy it to the frontend build.
SUPABASE_SERVICE_ROLE_KEY=


# ── 5. Messaging provider keys — NOT set here ───────────────────────────
# Africa's Talking (SMS) and WhatsApp Cloud API credentials are configured
# per-school, at runtime, in the app itself: Admin → API Config page,
# which writes to school_profile.at_api_key / wa_access_token / etc. in
# the database — not as environment variables. This lets each school
# manage its own messaging account without a redeploy. No .env entry
# needed for these.
