# Supabase — get these from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployment mode: 'demo' | 'production'
VITE_SHULE_MODE=production

# Only set if VITE_SHULE_MODE=demo
VITE_DEMO_SCHOOL_ID=

# PWA push notifications (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Never put real values here — this file is committed to GitHub
# Copy to .env.local and fill in real values for local development
